expression 'De DirectQuery a AS: tfmasajob_alerts' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Master%20Data%20Engineering%20Juandaib01", "tfmasajob_alerts"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="tfmasajob_alerts", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 90092df6-2b24-42af-a71f-4d5326efbf8e

	annotation PBI_IncludeFutureArtifacts = True

